# ---------------------------------------------------------------------------
# Raw observational data is NEVER committed.
#
# The CPCB records are published under the Open Database Licence, and the ERA5
# files under the Copernicus licence; neither is ours to redistribute, and
# both are large.  Everything under data/raw/ is regenerable with the fetch
# scripts in scripts/ (see DATA_CARD.md for licences and access terms).
#
# The only exceptions are the small station-metadata tables, which are public
# reference data (station names, cities, coordinates) and are needed to
# rebuild the graphs.
# ---------------------------------------------------------------------------
data/raw/**
!data/raw/stations.csv
!data/raw/cpcb_stations.csv
!data/raw/station_coords.csv
!data/raw/cpcb_station_catalog.csv

# The frozen dataset and its coverage report are regenerable, and large
data/processed/*.npz
data/processed/coverage_report.csv

# Large model checkpoints are regenerable with scripts/train_all.py
checkpoints/*.pt

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Outputs that are regenerated by scripts/analyze.py and scripts/make_report.py
outputs/*.png
outputs/*.gif
outputs/*.json
outputs/*.log
outputs/*.npy
outputs/*.npz
outputs/fold_*/

# LaTeX build artefacts
report/*.aux
report/*.log
report/*.pdf
report/*.out
