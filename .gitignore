# Raw and processed data are regenerable from the fetch scripts
data/raw/
data/processed/*.npz
data/processed/coverage_report.csv

# Large model checkpoints are regenerable from scripts/train_all.py
checkpoints/*.pt

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Outputs that are regenerated by scripts/analyze.py and scripts/make_report.py
outputs/*.png
outputs/*.gif
outputs/*.json
outputs/*.log

# LaTeX build artefacts
report/*.aux
report/*.log
report/*.pdf
report/*.out
